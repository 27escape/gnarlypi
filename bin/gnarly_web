#!/usr/bin/env python3

import os
import sys
import json
import time
import queue
import signal
import argparse
import threading
import shutil
from flask import Flask, render_template, Response, send_from_directory, jsonify, request

# ============================================================================
# Because gnarly_web is now in gnarlypi/bin/, traversing up one level ('../')
# correctly targets the main gnarlypi directory where libs/ resides.
sys.path.insert( 0, '../')
from libs.messaging import Messaging
from libs.config import Config
from libs.debug import Debug

# ============================================================================
USER = os.getenv("USER")
HOME = os.getenv("HOME")
APP_NAME = os.path.basename(__file__)

# get config from default location $GNARLYPI_CONFIG
config = Config()
logger = Debug( APP_NAME, config.get("gnarlypi.logfile"), config.get("gnarlypi.loglevel", "none"))
# get web port from config with a default of 8027
WEBPORT = config.get('website.port', 8027)

# BASE_DIR evaluates to /home/kevinmu/gnarlypi/bin
BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# Resolve the absolute path to the new website directory: /home/kevinmu/gnarlypi/website
WEBSITE_DIR = os.path.abspath(os.path.join(BASE_DIR, '../website'))

# Gallery Database Configuration
THUMBNAILS = config.get('indexer.thumbnails', '')
THUMBNAIL_JSON_DB = THUMBNAILS + "/db.json"
FILES = config.get('indexer.files', '')
INDEXES = config.get('indexer.index', '')

# Security Configuration: Parse PIN and strictly limit to 6 characters
DELETE_PIN = str(config.get('website.pin', ''))[:6]

# Explicitly define the allowed media root to bypass Flask's symlink security blocks
MEDIA_ROOT = config.get('website.media_root', f"{HOME}/usb_data")

# Enforce a hard minimum of 300 seconds to protect hardware resources.
# Strict int() casting applied to prevent configuration parsing crashes.
try:
    configured_sync = int(config.get('website.db_sync', 300))
except ValueError:
    logger.error("Invalid db_sync configuration value. Defaulting to 300.")
    configured_sync = 300

DB_JSON_SYNC = max(configured_sync, 300)

# In-memory storage for the parsed gallery to ensure high-performance API delivery
gallery_flat_data = {}
gallery_tree_data = {}
gallery_lock = threading.Lock()
last_db_mtime = 0

# ============================================================================
def load_gallery_database():
    """Reads the JSON DB and builds a hierarchical Year -> Day tree."""
    global gallery_flat_data, gallery_tree_data, last_db_mtime
    
    if not os.path.exists(THUMBNAIL_JSON_DB):
        logger.error(f"Gallery database not found at: {THUMBNAIL_JSON_DB}")
        return

    logger.info(f"Loading gallery database from: {THUMBNAIL_JSON_DB}")
    try:
        # Capture mtime before reading to avoid a race condition 
        # where the file is modified during the read operation.
        current_mtime = os.path.getmtime(THUMBNAIL_JSON_DB)
        
        with open(THUMBNAIL_JSON_DB, 'r') as f:
            raw_data = json.load(f)

        new_tree = {}
        
        # Build the hierarchy
        for filepath, meta in raw_data.items():
            date_str = meta.get('indexed_date')
            if not date_str:
                continue
                
            year = date_str.split('-')[0]
            
            if year not in new_tree:
                new_tree[year] = {}
            if date_str not in new_tree[year]:
                new_tree[year][date_str] = []
                
            new_tree[year][date_str].append(meta)

        # Apply Atomic Update using the lock
        with gallery_lock:
            gallery_flat_data = raw_data
            gallery_tree_data = new_tree
            last_db_mtime = current_mtime
            
        logger.info("Gallery database loaded and structured successfully.")
        
    except Exception as e:
        logger.error(f"Failed to parse gallery database: {e}")

def thread_database_sync():
    """Background daemon to monitor db.json for modifications and reload it."""
    logger.info(f"Starting database sync thread, checking every {DB_JSON_SYNC} seconds.")
    while True:
        time.sleep(DB_JSON_SYNC)
        try:
            if os.path.exists(THUMBNAIL_JSON_DB):
                current_mtime = os.path.getmtime(THUMBNAIL_JSON_DB)
                if current_mtime > last_db_mtime:
                    logger.info("Detected modifications to db.json. Reloading into memory.")
                    load_gallery_database()
        except Exception as e:
            logger.error(f"Error checking database modification time: {e}")

# ============================================================================
def signal_handler(sig, frame):
    """ """
    logger.info(f"Exit requested for {APP_NAME} by signal {sig}")
    sys.exit(1)

# ============================================================================
# Helper: Empty a directory without deleting the root folder itself
def clear_directory(folder_path):
    if not folder_path or not os.path.exists(folder_path):
        return
    for filename in os.listdir(folder_path):
        file_path = os.path.join(folder_path, filename)
        try:
            if os.path.isfile(file_path) or os.path.islink(file_path):
                os.unlink(file_path)
            elif os.path.isdir(file_path):
                shutil.rmtree(file_path)
        except Exception as e:
            logger.error(f"Failed to delete {file_path}. Reason: {e}")

# ============================================================================
# Flask App starts here

app = Flask(__name__,
    template_folder=os.path.join(WEBSITE_DIR, 'templates'),
    static_folder=os.path.join(WEBSITE_DIR, 'static'),
    static_url_path='/static' )

# Flask Routes
@app.route('/')
def index():
    """Serves the main navigation landing page."""
    logger.debug("New Index endpoint hit")
    return render_template('index.html')

@app.route('/status')
def status():
    """Serves the MQTT photo import status page."""
    logger.debug("Status endpoint hit")
    return render_template('status.html')


@app.route('/mqtt')
def mqtt_monitor():
    """Serves the MQTT monitoring page."""
    logger.debug("MQTT endpoint hit")
    return render_template('mqtt_monitor.html')


@app.route('/gallery')
def gallery():
    """Serves the main gallery application interface."""
    logger.debug("Gallery endpoint hit")
    return render_template('gallery.html')

@app.route('/wipe')
def wipe():
    """Serves the data wipe confirmation interface."""
    logger.debug("Wipe endpoint hit")
    # Pass the boolean requirement down to the frontend template
    return render_template('wipe.html', requires_pin=bool(DELETE_PIN))

# --- Backend API Routes ---

@app.route('/api/gallery/tree')
def api_gallery_tree():
    """Returns the pre-processed hierarchical gallery structure as JSON."""
    with gallery_lock:
        return jsonify(gallery_tree_data)

@app.route('/media/<path:filename>')
def serve_media(filename):
    """
    Securely serves media files from the base USB drive path.
    This explicit route is required because Flask's built-in web server 
    intentionally blocks symlinks that point outside the static directory.
    """
    return send_from_directory(MEDIA_ROOT, filename)

@app.route('/api/wipe', methods=['POST'])
def api_wipe():
    """Safely wipes all user data and resets the gallery state."""
    logger.info("Initiating full media wipe operation.")
    
    # Enforce PIN checking if configured
    if DELETE_PIN:
        data = request.get_json(silent=True) or {}
        provided_pin = str(data.get('pin', ''))[:6]
        if provided_pin != DELETE_PIN:
            logger.warning("Wipe operation rejected: Invalid PIN.")
            return jsonify({"status": "error", "message": "Invalid PIN provided."}), 401
            
    try:
        clear_directory(THUMBNAILS)
        clear_directory(FILES)
        clear_directory(INDEXES)

        # Safely clear the in-memory database
        global gallery_flat_data, gallery_tree_data, last_db_mtime
        with gallery_lock:
            gallery_flat_data = {}
            gallery_tree_data = {}
            last_db_mtime = 0
            
        logger.info("Media wipe completed successfully.")
        return jsonify({"status": "success", "message": "All media wiped successfully."})
        
    except Exception as e:
        logger.error(f"Wipe operation failed: {e}")
        return jsonify({"status": "error", "message": "Failed to complete the wipe operation."}), 500

# --- End API Routes ---

